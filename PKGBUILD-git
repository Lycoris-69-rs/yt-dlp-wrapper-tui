# Maintainer: Your Name <you@example.com>

# IMPORTANT: replace USERNAME with your GitHub account (or specify another repository URL).
_gh="USERNAME"

pkgname=yt-dlp-wrapper-tui-git
pkgver=1.0.0.r5.g4aa2e60
pkgrel=1
pkgdesc='TUI wrapper for yt-dlp with download queue and progress (git version)'
arch=('x86_64' 'aarch64')
url="https://github.com/$_gh/yt-dlp-wrapper-tui"
license=('MIT')
depends=(
  'gcc-libs'
  'glibc'
  'yt-dlp'
  'ffmpeg'
)
makedepends=('cargo' 'git')
provides=("yt-dlp-wrapper-tui")
conflicts=("yt-dlp-wrapper-tui")
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"

  local ver count rev
  ver=$(awk -F'"' '/^version[[:space:]]*=/ {print $2; exit}' Cargo.toml)
  count=$(git rev-list --count HEAD)
  rev=$(git rev-parse --short HEAD)

  printf '%s.r%s.g%s' "$ver" "$count" "$rev"
}

prepare() {
  cd "$pkgname"

  cargo fetch --locked
}

build() {
  cd "$pkgname"

  cargo build --release --locked
}

package() {
  cd "$pkgname"

  install -Dm755 "target/release/yt-dlp-wrapper-tui" "$pkgdir/usr/bin/yt-dlp-wrapper-tui"

  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
